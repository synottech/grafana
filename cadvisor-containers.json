{
  "apiVersion": "dashboard.grafana.app/v0alpha1",
  "kind": "Dashboard",
  "metadata": {
    "name": "cadvisor-containers"
  },
  "spec": {
    "panels": [
      {
        "fieldConfig": {
          "defaults": {
            "unit": "cores"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum by (name)(rate(container_cpu_usage_seconds_total[5m]))"
          }
        ],
        "title": "Container CPU (cores)",
        "type": "timeseries"
      },
      {
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "max by (name)(container_memory_usage_bytes)"
          }
        ],
        "title": "Container Memory (bytes)",
        "type": "timeseries"
      },
      {
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "sum by (name)(container_fs_usage_bytes)"
          }
        ],
        "title": "Container FS Usage (bytes)",
        "type": "timeseries"
      },
      {
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "sum by (name)(rate(container_network_receive_bytes_total[5m]))"
          },
          {
            "expr": "sum by (name)(rate(container_network_transmit_bytes_total[5m]))"
          }
        ],
        "title": "Container Net RX/TX (bytes/s)",
        "type": "timeseries"
      }
    ],
    "schemaVersion": 39,
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timezone": "browser",
    "title": "cAdvisor Containers"
  }
}